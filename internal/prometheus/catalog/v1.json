{
  "version": "v1",
  "queries": [
    {
      "id": "container_cpu_usage",
      "category": "pod_container_cpu",
      "description": "Per-container CPU usage rate in cores.",
      "promql": "sum by (namespace, pod, container) (rate(container_cpu_usage_seconds_total{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"}[5m]))",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    },
    {
      "id": "container_memory_limit",
      "category": "memory_working_set_and_limits",
      "description": "Configured per-container memory limit in bytes.",
      "promql": "max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=~\"{{namespace_regex}}\",resource=\"memory\",unit=\"byte\"})",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    },
    {
      "id": "container_memory_working_set",
      "category": "memory_working_set_and_limits",
      "description": "Per-container memory working set in bytes.",
      "promql": "sum by (namespace, pod, container) (container_memory_working_set_bytes{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"})",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    },
    {
      "id": "container_oom_terminated",
      "category": "restart_oom",
      "description": "Containers whose last termination was caused by OOMKilled.",
      "promql": "max by (namespace, pod, container) (kube_pod_container_status_last_terminated_reason{namespace=~\"{{namespace_regex}}\",reason=\"OOMKilled\"})",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    },
    {
      "id": "container_restarts",
      "category": "restart_oom",
      "description": "Per-container restart increase over one hour.",
      "promql": "sum by (namespace, pod, container) (increase(kube_pod_container_status_restarts_total{namespace=~\"{{namespace_regex}}\"}[1h]))",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    },
    {
      "id": "deployment_replica_availability",
      "category": "replica_availability",
      "description": "Available deployment replicas divided by desired replicas.",
      "promql": "kube_deployment_status_replicas_available{namespace=~\"{{namespace_regex}}\"} / clamp_min(kube_deployment_spec_replicas{namespace=~\"{{namespace_regex}}\"}, 1)",
      "step_seconds": 60,
      "retain_labels": ["deployment", "namespace"]
    },
    {
      "id": "http_error_rate",
      "category": "error_rate",
      "description": "HTTP 5xx response rate by namespace and service.",
      "promql": "sum by (namespace, service) (rate(http_requests_total{namespace=~\"{{namespace_regex}}\",code=~\"5..\"}[5m]))",
      "step_seconds": 60,
      "retain_labels": ["namespace", "service"]
    },
    {
      "id": "http_latency_p95",
      "category": "latency",
      "description": "HTTP request latency p95 by namespace and service.",
      "promql": "histogram_quantile(0.95, sum by (namespace, service, le) (rate(http_request_duration_seconds_bucket{namespace=~\"{{namespace_regex}}\"}[5m])))",
      "step_seconds": 60,
      "retain_labels": ["namespace", "service"]
    },
    {
      "id": "http_request_rate",
      "category": "request_rate",
      "description": "HTTP request rate by namespace and service.",
      "promql": "sum by (namespace, service) (rate(http_requests_total{namespace=~\"{{namespace_regex}}\"}[5m]))",
      "step_seconds": 60,
      "retain_labels": ["namespace", "service"]
    },
    {
      "id": "persistent_volume_capacity_pressure",
      "category": "storage_pressure",
      "description": "Persistent volume used capacity ratio by claim.",
      "promql": "kubelet_volume_stats_used_bytes{namespace=~\"{{namespace_regex}}\"} / clamp_min(kubelet_volume_stats_capacity_bytes{namespace=~\"{{namespace_regex}}\"}, 1)",
      "step_seconds": 60,
      "retain_labels": ["namespace", "persistentvolumeclaim"]
    },
    {
      "id": "workload_cpu_throttling_saturation",
      "category": "queue_saturation",
      "description": "Container CPU throttled periods divided by scheduled periods.",
      "promql": "(sum by (namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"}[5m])) / sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"}[5m]))) and on (namespace, pod, container) (sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"}[5m])) > 0)",
      "step_seconds": 60,
      "retain_labels": ["container", "namespace", "pod"]
    }
  ]
}
