[
  {
    "id": "container_cpu_usage",
    "metric": "container_cpu_usage_seconds_total",
    "selector": "namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\""
  },
  {
    "id": "container_memory_limit",
    "metric": "kube_pod_container_resource_limits",
    "selector": "namespace=~\"{{namespace_regex}}\",resource=\"memory\",unit=\"byte\""
  },
  {
    "id": "container_memory_working_set",
    "metric": "container_memory_working_set_bytes",
    "selector": "namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\""
  },
  {
    "id": "container_oom_terminated",
    "metric": "kube_pod_container_status_last_terminated_reason",
    "selector": "namespace=~\"{{namespace_regex}}\",reason=\"OOMKilled\""
  },
  {
    "id": "container_restarts",
    "metric": "kube_pod_container_status_restarts_total",
    "selector": "namespace=~\"{{namespace_regex}}\""
  },
  {
    "id": "deployment_replica_availability",
    "metric": "kube_deployment_status_replicas_available",
    "selector": "kube_deployment_spec_replicas{namespace=~\"{{namespace_regex}}\"}"
  },
  {
    "id": "http_error_rate",
    "metric": "http_requests_total",
    "selector": "namespace=~\"{{namespace_regex}}\",code=~\"5..\""
  },
  {
    "id": "http_latency_p95",
    "metric": "http_request_duration_seconds_bucket",
    "selector": "namespace=~\"{{namespace_regex}}\""
  },
  {
    "id": "http_request_rate",
    "metric": "http_requests_total",
    "selector": "namespace=~\"{{namespace_regex}}\""
  },
  {
    "id": "persistent_volume_capacity_pressure",
    "metric": "kubelet_volume_stats_used_bytes",
    "selector": "kubelet_volume_stats_capacity_bytes{namespace=~\"{{namespace_regex}}\"}"
  },
  {
    "id": "workload_cpu_throttling_saturation",
    "metric": "container_cpu_cfs_throttled_periods_total",
    "selector": "container_cpu_cfs_periods_total{namespace=~\"{{namespace_regex}}\",container!=\"\",pod!=\"\"}"
  }
]
